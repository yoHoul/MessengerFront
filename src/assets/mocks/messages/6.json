[
  { "id": "6001", "chatId": "6", "authorId": "1", "text": "Коллеги, нужен план на неделю.", "createdAt": "2026-10-18T09:00:00+06:00" },
  { "id": "6002", "chatId": "6", "authorId": "7", "text": "Предлагаю сначала закрыть API.", "createdAt": "2026-10-18T09:05:00+06:00" },
  { "id": "6003", "chatId": "6", "authorId": "8", "text": "Согласен.", "createdAt": "2026-10-18T09:07:00+06:00" },
  { "id": "6004", "chatId": "6", "authorId": "2", "text": "Могу заняться фронтом после контракта.", "createdAt": "2026-10-18T09:10:00+06:00" },
  { "id": "6005", "chatId": "6", "authorId": "1", "text": "Тогда API — приоритет.", "createdAt": "2026-10-18T09:12:00+06:00" },
  { "id": "6006", "chatId": "6", "authorId": "7", "text": "Начинаю с авторизации.", "createdAt": "2026-10-18T09:15:00+06:00" },
  { "id": "6007", "chatId": "6", "authorId": "8", "text": "Я подготовлю тесты.", "createdAt": "2026-10-18T09:18:00+06:00" },
  { "id": "6008", "chatId": "6", "authorId": "2", "text": "Не забудьте про обработку ошибок.", "replyToId": "6006", "createdAt": "2026-10-18T09:20:00+06:00" },
  { "id": "6009", "chatId": "6", "authorId": "1", "text": "Да, 401 и 409.", "createdAt": "2026-10-18T09:22:00+06:00" },
  { "id": "6010", "chatId": "6", "authorId": "7", "text": "Добавлю в контракт.", "createdAt": "2026-10-18T09:25:00+06:00" },
  { "id": "6011", "chatId": "6", "authorId": "8", "text": "Ещё нужна пагинация сообщений.", "createdAt": "2026-10-18T09:30:00+06:00" },
  { "id": "6012", "chatId": "6", "authorId": "1", "text": "Обсудим после обеда.", "replyToId": "6011", "createdAt": "2026-10-18T09:32:00+06:00" },
  { "id": "6013", "chatId": "6", "authorId": "7", "text": "Ок.", "createdAt": "2026-10-18T09:33:00+06:00" },
  { "id": "6014", "chatId": "6", "authorId": "2", "text": "Я пока доделаю профиль.", "createdAt": "2026-10-18T09:35:00+06:00" },
  { "id": "6015", "chatId": "6", "authorId": "8", "text": "Хорошо.", "createdAt": "2026-10-18T09:37:00+06:00" },
  { "id": "6016", "chatId": "6", "authorId": "1", "text": "Созвон в 14:00.", "createdAt": "2026-10-18T11:50:00+06:00" },
  { "id": "6017", "chatId": "6", "authorId": "7", "text": "Буду.", "createdAt": "2026-10-18T11:52:00+06:00" },
  { "id": "6018", "chatId": "6", "authorId": "8", "text": "Буду.", "createdAt": "2026-10-18T11:53:00+06:00" },
  { "id": "6019", "chatId": "6", "authorId": "2", "text": "Буду.", "createdAt": "2026-10-18T11:54:00+06:00" },
  { "id": "6020", "chatId": "6", "authorId": "1", "text": "Начинаем.", "createdAt": "2026-10-18T14:00:00+06:00" },
  { "id": "6021", "chatId": "6", "authorId": "7", "text": "Показываю новый контракт.", "createdAt": "2026-10-18T14:02:00+06:00" },
  { "id": "6022", "chatId": "6", "authorId": "8", "text": "Выглядит логично.", "createdAt": "2026-10-18T14:05:00+06:00" },
  { "id": "6023", "chatId": "6", "authorId": "2", "text": "Мне нравится.", "createdAt": "2026-10-18T14:07:00+06:00" },
  { "id": "6024", "chatId": "6", "authorId": "1", "text": "Что с обратной совместимостью?", "replyToId": "6021", "createdAt": "2026-10-18T14:10:00+06:00" },
  { "id": "6025", "chatId": "6", "authorId": "7", "text": "Старые поля оставляем.", "createdAt": "2026-10-18T14:12:00+06:00" },
  { "id": "6026", "chatId": "6", "authorId": "8", "text": "Тогда можно катить.", "createdAt": "2026-10-18T14:15:00+06:00" },
  { "id": "6027", "chatId": "6", "authorId": "2", "text": "Я обновлю клиент.", "createdAt": "2026-10-18T14:17:00+06:00" },
  { "id": "6028", "chatId": "6", "authorId": "1", "text": "Спасибо.", "createdAt": "2026-10-18T14:20:00+06:00" },
  { "id": "6029", "chatId": "6", "authorId": "8", "text": "Жду PR.", "createdAt": "2026-10-18T14:25:00+06:00" },
  { "id": "6030", "chatId": "6", "authorId": "7", "text": "Обновила API-контракт.", "createdAt": "2026-10-18T14:30:00+06:00" }
