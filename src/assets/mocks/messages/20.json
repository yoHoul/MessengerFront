[
  { "id": "20001", "chatId": "20", "authorId": "12", "text": "Собрали новую сборку.", "createdAt": "2026-10-19T18:00:00+06:00" },
  { "id": "20002", "chatId": "20", "authorId": "13", "text": "Ссылку?", "createdAt": "2026-10-19T18:02:00+06:00" },
  { "id": "20003", "chatId": "20", "authorId": "12", "text": "Сейчас скину.", "createdAt": "2026-10-19T18:04:00+06:00" },
  { "id": "20004", "chatId": "20", "authorId": "1", "text": "Что проверять в первую очередь?", "createdAt": "2026-10-19T18:07:00+06:00" },
  { "id": "20005", "chatId": "20", "authorId": "2", "text": "Авторизацию и профиль.", "createdAt": "2026-10-19T18:10:00+06:00" },
  { "id": "20006", "chatId": "20", "authorId": "13", "text": "Я возьму поиск.", "createdAt": "2026-10-19T18:12:00+06:00" },
  { "id": "20007", "chatId": "20", "authorId": "12", "text": "Я — сообщения.", "createdAt": "2026-10-19T18:14:00+06:00" },
  { "id": "20008", "chatId": "20", "authorId": "1", "text": "Я — регистрацию.", "createdAt": "2026-10-19T18:16:00+06:00" },
  { "id": "20009", "chatId": "20", "authorId": "2", "text": "Не забывайте про мобильную ширину.", "createdAt": "2026-10-19T18:18:00+06:00" },
  { "id": "20010", "chatId": "20", "authorId": "13", "text": "Ок.", "createdAt": "2026-10-19T18:20:00+06:00" },
  { "id": "20011", "chatId": "20", "authorId": "12", "text": "Нашёл баг в профиле.", "createdAt": "2026-10-19T18:30:00+06:00" },
  { "id": "20012", "chatId": "20", "authorId": "1", "text": "Какой?", "createdAt": "2026-10-19T18:32:00+06:00" },
  { "id": "20013", "chatId": "20", "authorId": "12", "text": "Кнопка сохранения активна без изменений.", "createdAt": "2026-10-19T18:34:00+06:00" },
  { "id": "20014", "chatId": "20", "authorId": "2", "text": "Уже пофиксили.", "createdAt": "2026-10-19T18:36:00+06:00" },
  { "id": "20015", "chatId": "20", "authorId": "1", "text": "Проверю.", "createdAt": "2026-10-19T18:38:00+06:00" },
  { "id": "20016", "chatId": "20", "authorId": "13", "text": "В поиске пустое состояние странное.", "createdAt": "2026-10-19T18:45:00+06:00" },
  { "id": "20017", "chatId": "20", "authorId": "2", "text": "Что именно?", "createdAt": "2026-10-19T18:47:00+06:00" },
  { "id": "20018", "chatId": "20", "authorId": "13", "text": "Показывает «ничего не найдено» до ответа.", "createdAt": "2026-10-19T18:49:00+06:00" },
  { "id": "20019", "chatId": "20", "authorId": "1", "text": "Понял, поправим.", "createdAt": "2026-10-19T18:52:00+06:00" },
  { "id": "20020", "chatId": "20", "authorId": "12", "text": "Ещё один баг: старые сообщения в новом чате.", "createdAt": "2026-10-19T19:00:00+06:00" },
  { "id": "20021", "chatId": "20", "authorId": "2", "text": "Это уже исправлено.", "createdAt": "2026-10-19T19:03:00+06:00" },
  { "id": "20022", "chatId": "20", "authorId": "1", "text": "Проверь, пожалуйста.", "createdAt": "2026-10-19T19:05:00+06:00" },
  { "id": "20023", "chatId": "20", "authorId": "12", "text": "Проверил, ок.", "createdAt": "2026-10-19T19:10:00+06:00" },
  { "id": "20024", "chatId": "20", "authorId": "13", "text": "У меня два падения.", "createdAt": "2026-10-19T19:20:00+06:00" },
  { "id": "20025", "chatId": "20", "authorId": "1", "text": "Логи пришли.", "createdAt": "2026-10-19T19:22:00+06:00" },
  { "id": "20026", "chatId": "20", "authorId": "13", "text": "Отправил.", "createdAt": "2026-10-19T19:25:00+06:00" },
  { "id": "20027", "chatId": "20", "authorId": "2", "text": "Смотрю.", "createdAt": "2026-10-19T19:30:00+06:00" },
  { "id": "20028", "chatId": "20", "authorId": "12", "text": "Осталась одна проверка.", "createdAt": "2026-10-19T20:50:00+06:00" },
  { "id": "20029", "chatId": "20", "authorId": "1", "text": "Проверю.", "createdAt": "2026-10-19T20:55:00+06:00" },
  { "id": "20030", "chatId": "20", "authorId": "12", "text": "Сборка 1.2.0 готова.", "createdAt": "2026-10-19T21:00:00+06:00" }
]
