[
  { "id": "8001", "chatId": "8", "authorId": "10", "text": "Принял смену.", "createdAt": "2026-10-15T20:00:00+06:00" },
  { "id": "8002", "chatId": "8", "authorId": "11", "text": "Как обстановка?", "createdAt": "2026-10-15T20:03:00+06:00" },
  { "id": "8003", "chatId": "8", "authorId": "10", "text": "Пока тихо.", "createdAt": "2026-10-15T20:05:00+06:00" },
  { "id": "8004", "chatId": "8", "authorId": "1", "text": "Добрый вечер.", "createdAt": "2026-10-15T20:10:00+06:00" },
  { "id": "8005", "chatId": "8", "authorId": "2", "text": "Вечер добрый.", "createdAt": "2026-10-15T20:12:00+06:00" },
  { "id": "8006", "chatId": "8", "authorId": "11", "text": "Проверьте очередь, пожалуйста.", "createdAt": "2026-10-15T20:15:00+06:00" },
  { "id": "8007", "chatId": "8", "authorId": "10", "text": "Проверил, два тикета.", "createdAt": "2026-10-15T20:18:00+06:00" },
  { "id": "8008", "chatId": "8", "authorId": "1", "text": "Что по первому?", "createdAt": "2026-10-15T20:20:00+06:00" },
  { "id": "8009", "chatId": "8", "authorId": "10", "text": "Пользователь не может войти.", "createdAt": "2026-10-15T20:22:00+06:00" },
  { "id": "8010", "chatId": "8", "authorId": "2", "text": "Проверю логи.", "createdAt": "2026-10-15T20:25:00+06:00" },
  { "id": "8011", "chatId": "8", "authorId": "11", "text": "Второй — ошибка оплаты.", "createdAt": "2026-10-15T20:27:00+06:00" },
  { "id": "8012", "chatId": "8", "authorId": "1", "text": "Передай в биллинг.", "createdAt": "2026-10-15T20:30:00+06:00" },
  { "id": "8013", "chatId": "8", "authorId": "10", "text": "Передал.", "createdAt": "2026-10-15T20:32:00+06:00" },
  { "id": "8014", "chatId": "8", "authorId": "2", "text": "По логину вижу 401.", "createdAt": "2026-10-15T20:35:00+06:00" },
  { "id": "8015", "chatId": "8", "authorId": "10", "text": "Пароль меняли?", "createdAt": "2026-10-15T20:37:00+06:00" },
  { "id": "8016", "chatId": "8", "authorId": "2", "text": "Похоже, да.", "createdAt": "2026-10-15T20:40:00+06:00" },
  { "id": "8017", "chatId": "8", "authorId": "1", "text": "Напиши пользователю.", "createdAt": "2026-10-15T20:42:00+06:00" },
  { "id": "8018", "chatId": "8", "authorId": "10", "text": "Написал.", "createdAt": "2026-10-15T20:45:00+06:00" },
  { "id": "8019", "chatId": "8", "authorId": "11", "text": "Ответили.", "createdAt": "2026-10-15T20:48:00+06:00" },
  { "id": "8020", "chatId": "8", "authorId": "2", "text": "Вход восстановлен.", "createdAt": "2026-10-15T20:50:00+06:00" },
  { "id": "8021", "chatId": "8", "authorId": "1", "text": "Отлично.", "createdAt": "2026-10-15T20:52:00+06:00" },
  { "id": "8022", "chatId": "8", "authorId": "10", "text": "Остался один тикет.", "createdAt": "2026-10-15T21:00:00+06:00" },
  { "id": "8023", "chatId": "8", "authorId": "11", "text": "Я на связи.", "createdAt": "2026-10-15T21:03:00+06:00" },
  { "id": "8024", "chatId": "8", "authorId": "2", "text": "Мне пора.", "createdAt": "2026-10-15T21:10:00+06:00" },
  { "id": "8025", "chatId": "8", "authorId": "1", "text": "До завтра.", "createdAt": "2026-10-15T21:12:00+06:00" },
  { "id": "8026", "chatId": "8", "authorId": "10", "text": "Проверю ещё раз очередь.", "createdAt": "2026-10-15T22:00:00+06:00" },
  { "id": "8027", "chatId": "8", "authorId": "11", "text": "Всё чисто.", "createdAt": "2026-10-15T22:10:00+06:00" },
  { "id": "8028", "chatId": "8", "authorId": "1", "text": "Спасибо.", "createdAt": "2026-10-15T22:20:00+06:00" },
  { "id": "8029", "chatId": "8", "authorId": "11", "text": "До утра.", "createdAt": "2026-10-15T22:25:00+06:00" },
  { "id": "8030", "chatId": "8", "authorId": "10", "text": "Смена принята, всё тихо.", "createdAt": "2026-10-15T22:30:00+06:00" }
]
