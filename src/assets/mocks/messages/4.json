[
  { "id": "4001", "chatId": "4", "authorId": "2", "text": "Собрала новые макеты профиля.", "createdAt": "2026-10-19T10:00:00+06:00" },
  { "id": "4002", "chatId": "4", "authorId": "9", "text": "Посмотрю, спасибо.", "createdAt": "2026-10-19T10:05:00+06:00" },
  { "id": "4003", "chatId": "4", "authorId": "1", "text": "Что изменилось?", "createdAt": "2026-10-19T10:08:00+06:00" },
  { "id": "4004", "chatId": "4", "authorId": "2", "text": "Добавила блок с тегом и настройками.", "createdAt": "2026-10-19T10:10:00+06:00" },
  { "id": "4005", "chatId": "4", "authorId": "5", "text": "Мне нравится, но отступы большие.", "createdAt": "2026-10-19T10:15:00+06:00" },
  { "id": "4006", "chatId": "4", "authorId": "9", "text": "Согласна, надо уменьшить.", "createdAt": "2026-10-19T10:17:00+06:00" },
  { "id": "4007", "chatId": "4", "authorId": "1", "text": "Давайте обсудим на ревью.", "createdAt": "2026-10-19T10:20:00+06:00" },
  { "id": "4008", "chatId": "4", "authorId": "2", "text": "Ок, в 12:00.", "createdAt": "2026-10-19T10:22:00+06:00" },
  { "id": "4009", "chatId": "4", "authorId": "5", "text": "Буду.", "createdAt": "2026-10-19T10:24:00+06:00" },
  { "id": "4010", "chatId": "4", "authorId": "9", "text": "Буду.", "createdAt": "2026-10-19T10:25:00+06:00" },
  { "id": "4011", "chatId": "4", "authorId": "1", "text": "Буду.", "createdAt": "2026-10-19T10:26:00+06:00" },
  { "id": "4012", "chatId": "4", "authorId": "2", "text": "Напоминаю, ревью в 12:00.", "createdAt": "2026-10-19T11:50:00+06:00" },
  { "id": "4013", "chatId": "4", "authorId": "9", "text": "Уже открыла фигму.", "createdAt": "2026-10-19T11:55:00+06:00" },
  { "id": "4014", "chatId": "4", "authorId": "5", "text": "Смотрю.", "createdAt": "2026-10-19T11:58:00+06:00" },
  { "id": "4015", "chatId": "4", "authorId": "1", "text": "Начали.", "createdAt": "2026-10-19T12:00:00+06:00" },
  { "id": "4016", "chatId": "4", "authorId": "2", "text": "Первый экран — профиль.", "createdAt": "2026-10-19T12:02:00+06:00" },
  { "id": "4017", "chatId": "4", "authorId": "9", "text": "Аватар лучше сделать больше.", "createdAt": "2026-10-19T12:05:00+06:00" },
  { "id": "4018", "chatId": "4", "authorId": "5", "text": "И тег вторичным цветом.", "createdAt": "2026-10-19T12:07:00+06:00" },
  { "id": "4019", "chatId": "4", "authorId": "1", "text": "Согласен.", "createdAt": "2026-10-19T12:09:00+06:00" },
  { "id": "4020", "chatId": "4", "authorId": "2", "text": "Поправлю.", "createdAt": "2026-10-19T12:11:00+06:00" },
  { "id": "4021", "chatId": "4", "authorId": "9", "text": "Ещё вопрос по кнопке сохранения.", "createdAt": "2026-10-19T12:14:00+06:00" },
  { "id": "4022", "chatId": "4", "authorId": "5", "text": "Её лучше дизейблить без изменений.", "createdAt": "2026-10-19T12:16:00+06:00" },
  { "id": "4023", "chatId": "4", "authorId": "1", "text": "Логично.", "createdAt": "2026-10-19T12:18:00+06:00" },
  { "id": "4024", "chatId": "4", "authorId": "2", "text": "Сделаю.", "createdAt": "2026-10-19T12:20:00+06:00" },
  { "id": "4025", "chatId": "4", "authorId": "9", "text": "Тогда жду новую версию.", "createdAt": "2026-10-19T12:25:00+06:00" },
  { "id": "4026", "chatId": "4", "authorId": "5", "text": "Скинь, как будет.", "createdAt": "2026-10-19T12:27:00+06:00" },
  { "id": "4027", "chatId": "4", "authorId": "1", "text": "Спасибо всем.", "createdAt": "2026-10-19T12:30:00+06:00" },
  { "id": "4028", "chatId": "4", "authorId": "2", "text": "Обновлю макеты к вечеру.", "createdAt": "2026-10-19T12:32:00+06:00" },
  { "id": "4029", "chatId": "4", "authorId": "9", "text": "Хорошо.", "createdAt": "2026-10-19T12:34:00+06:00" },
  { "id": "4030", "chatId": "4", "authorId": "9", "text": "Добавила комментарии в фигму.", "createdAt": "2026-10-19T12:40:00+06:00" }
]
