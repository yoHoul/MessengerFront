[
  { "id": "2001", "chatId": "2", "authorId": "2", "text": "Всем привет! Начинаем неделю.", "createdAt": "2026-10-19T09:00:00+06:00" },
  { "id": "2002", "chatId": "2", "authorId": "1", "text": "Привет. Какие задачи на сегодня?", "createdAt": "2026-10-19T09:02:00+06:00" },
  { "id": "2003", "chatId": "2", "authorId": "3", "text": "Я доделываю экран поиска.", "createdAt": "2026-10-19T09:05:00+06:00" },
  { "id": "2004", "chatId": "2", "authorId": "4", "text": "У меня рефакторинг списка чатов.", "createdAt": "2026-10-19T09:07:00+06:00" },
  { "id": "2005", "chatId": "2", "authorId": "2", "text": "Не забудьте про макеты, они в фигме.", "createdAt": "2026-10-19T09:10:00+06:00" },
  { "id": "2006", "chatId": "2", "authorId": "1", "text": "Скинь ссылку, пожалуйста.", "createdAt": "2026-10-19T09:12:00+06:00" },
  { "id": "2007", "chatId": "2", "authorId": "2", "text": "Ссылка в закрепе.", "createdAt": "2026-10-19T09:14:00+06:00" },
  { "id": "2008", "chatId": "2", "authorId": "3", "text": "Поиск почти готов, осталось пустое состояние.", "replyToId": "2005", "createdAt": "2026-10-19T09:20:00+06:00" },
  { "id": "2009", "chatId": "2", "authorId": "4", "text": "Список чатов переделал на сигналы.", "createdAt": "2026-10-19T09:25:00+06:00" },
  { "id": "2010", "chatId": "2", "authorId": "1", "text": "Отлично. Нужно ещё проверить мобильную ширину.", "createdAt": "2026-10-19T09:28:00+06:00" },
  { "id": "2011", "chatId": "2", "authorId": "2", "text": "Я проверю после обеда.", "createdAt": "2026-10-19T09:30:00+06:00" },
  { "id": "2012", "chatId": "2", "authorId": "3", "text": "У меня вопрос по API поиска.", "replyToId": "2010", "createdAt": "2026-10-19T09:40:00+06:00" },
  { "id": "2013", "chatId": "2", "authorId": "1", "text": "Давай после стендапа.", "createdAt": "2026-10-19T09:42:00+06:00" },
  { "id": "2014", "chatId": "2", "authorId": "2", "text": "Стендап в 11:00, не опаздывайте.", "createdAt": "2026-10-19T09:45:00+06:00" },
  { "id": "2015", "chatId": "2", "authorId": "4", "text": "Буду.", "createdAt": "2026-10-19T09:46:00+06:00" },
  { "id": "2016", "chatId": "2", "authorId": "3", "text": "Буду.", "createdAt": "2026-10-19T09:47:00+06:00" },
  { "id": "2017", "chatId": "2", "authorId": "1", "text": "Буду.", "createdAt": "2026-10-19T09:48:00+06:00" },
  { "id": "2018", "chatId": "2", "authorId": "2", "text": "Напоминаю про код-ревью.", "createdAt": "2026-10-19T12:10:00+06:00" },
  { "id": "2019", "chatId": "2", "authorId": "1", "text": "Посмотрю два PR после обеда.", "createdAt": "2026-10-19T12:12:00+06:00" },
  { "id": "2020", "chatId": "2", "authorId": "4", "text": "Спасибо, там небольшой рефакторинг.", "createdAt": "2026-10-19T12:15:00+06:00" },
  { "id": "2021", "chatId": "2", "authorId": "3", "text": "У меня тоже есть PR по поиску.", "replyToId": "2018", "createdAt": "2026-10-19T12:20:00+06:00" },
  { "id": "2022", "chatId": "2", "authorId": "2", "text": "Добавь в очередь, глянем.", "createdAt": "2026-10-19T12:22:00+06:00" },
  { "id": "2023", "chatId": "2", "authorId": "1", "text": "К обеду успеем?", "createdAt": "2026-10-19T13:00:00+06:00" },
  { "id": "2024", "chatId": "2", "authorId": "3", "text": "Думаю, да.", "createdAt": "2026-10-19T13:02:00+06:00" },
  { "id": "2025", "chatId": "2", "authorId": "4", "text": "У меня остался один тест.", "createdAt": "2026-10-19T13:05:00+06:00" },
  { "id": "2026", "chatId": "2", "authorId": "2", "text": "Тогда в 16:00 общий созвон.", "createdAt": "2026-10-19T16:10:00+06:00" },
  { "id": "2027", "chatId": "2", "authorId": "1", "text": "Ок.", "createdAt": "2026-10-19T16:12:00+06:00" },
  { "id": "2028", "chatId": "2", "authorId": "4", "text": "Ок.", "createdAt": "2026-10-19T16:13:00+06:00" },
  { "id": "2029", "chatId": "2", "authorId": "3", "text": "Напоминаю, созвон в 19:00.", "replyToId": "2026", "createdAt": "2026-10-19T17:00:00+06:00" },
